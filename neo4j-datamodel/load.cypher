// Generated by tools/datamodel/build.py -- do not edit by hand; rebuild instead.
// Copy the nodes/ and relationships/ folders into the Neo4j import directory,
// then run this file (cypher-shell -f load.cypher, or paste into Neo4j Browser).
// Loads into an empty database; run it once.

CREATE CONSTRAINT port_id IF NOT EXISTS FOR (n:Port) REQUIRE n.port_id IS UNIQUE;
CREATE CONSTRAINT airfield_id IF NOT EXISTS FOR (n:Airfield) REQUIRE n.airfield_id IS UNIQUE;
CREATE CONSTRAINT runway_id IF NOT EXISTS FOR (n:Runway) REQUIRE n.runway_id IS UNIQUE;
CREATE CONSTRAINT sea_node_id IF NOT EXISTS FOR (n:SeaNode) REQUIRE n.sea_node_id IS UNIQUE;
CREATE CONSTRAINT passage_id IF NOT EXISTS FOR (n:Passage) REQUIRE n.passage_id IS UNIQUE;
CREATE POINT INDEX port_location IF NOT EXISTS FOR (n:Port) ON (n.location);
CREATE POINT INDEX airfield_location IF NOT EXISTS FOR (n:Airfield) ON (n.location);
CREATE INDEX sea_segment_passage IF NOT EXISTS FOR ()-[r:SEA_SEGMENT]-() ON (r.passage);
CREATE INDEX sea_segment_id IF NOT EXISTS FOR ()-[r:SEA_SEGMENT]-() ON (r.segment_id);
CREATE INDEX sea_access_segment IF NOT EXISTS FOR ()-[r:SEA_ACCESS]-() ON (r.segment_id);

// ---- nodes
LOAD CSV WITH HEADERS FROM 'file:///nodes/ports.csv' AS row
CREATE (p:Port {port_id: row.port_id})
SET
  p.wpi_number = toInteger(row.wpi_number),
  p.name = row.name,
  p.alternate_name = row.alternate_name,
  p.unlocode = row.unlocode,
  p.country = row.country,
  p.region_name = row.region_name,
  p.water_body = row.water_body,
  p.lat = toFloat(row.lat),
  p.lon = toFloat(row.lon),
  p.harbor_size = row.harbor_size,
  p.harbor_type = row.harbor_type,
  p.harbor_use = row.harbor_use,
  p.shelter = row.shelter,
  p.repairs = row.repairs,
  p.dry_dock = row.dry_dock,
  p.railway = row.railway,
  p.sailing_directions = row.sailing_directions,
  p.tidal_range_m = toFloat(row.tidal_range_m),
  p.entrance_width_m = toFloat(row.entrance_width_m),
  p.channel_depth_m = toFloat(row.channel_depth_m),
  p.anchorage_depth_m = toFloat(row.anchorage_depth_m),
  p.cargo_pier_depth_m = toFloat(row.cargo_pier_depth_m),
  p.oil_terminal_depth_m = toFloat(row.oil_terminal_depth_m),
  p.lng_terminal_depth_m = toFloat(row.lng_terminal_depth_m),
  p.max_vessel_length_m = toFloat(row.max_vessel_length_m),
  p.max_vessel_beam_m = toFloat(row.max_vessel_beam_m),
  p.max_vessel_draft_m = toFloat(row.max_vessel_draft_m),
  p.controlling_depth_m = toFloat(row.controlling_depth_m),
  p.controlling_depth_basis = row.controlling_depth_basis,
  p.first_port_of_entry = toBoolean(row.first_port_of_entry),
  p.pilotage_compulsory = toBoolean(row.pilotage_compulsory),
  p.tugs_assistance = toBoolean(row.tugs_assistance),
  p.fac_wharves = toBoolean(row.fac_wharves),
  p.fac_anchorage = toBoolean(row.fac_anchorage),
  p.fac_roro = toBoolean(row.fac_roro),
  p.fac_container = toBoolean(row.fac_container),
  p.fac_breakbulk = toBoolean(row.fac_breakbulk),
  p.fac_solid_bulk = toBoolean(row.fac_solid_bulk),
  p.fac_liquid_bulk = toBoolean(row.fac_liquid_bulk),
  p.fac_oil_terminal = toBoolean(row.fac_oil_terminal),
  p.fac_lng_terminal = toBoolean(row.fac_lng_terminal),
  p.cranes_fixed = toBoolean(row.cranes_fixed),
  p.cranes_mobile = toBoolean(row.cranes_mobile),
  p.cranes_floating = toBoolean(row.cranes_floating),
  p.cranes_container = toBoolean(row.cranes_container),
  p.lifts_100t_plus = toBoolean(row.lifts_100t_plus),
  p.supply_fuel_oil = toBoolean(row.supply_fuel_oil),
  p.supply_diesel = toBoolean(row.supply_diesel),
  p.supply_aviation_fuel = toBoolean(row.supply_aviation_fuel),
  p.supply_potable_water = toBoolean(row.supply_potable_water),
  p.supply_provisions = toBoolean(row.supply_provisions),
  p.sea_access_nm = toFloat(row.sea_access_nm),
  p.access_quality = row.access_quality,
  p.reaches_open_ocean = toBoolean(row.reaches_open_ocean),
  p.location = point({longitude: toFloat(row.lon), latitude: toFloat(row.lat)});

LOAD CSV WITH HEADERS FROM 'file:///nodes/airfields.csv' AS row
CREATE (a:Airfield {airfield_id: row.airfield_id})
SET
  a.ourairports_id = toInteger(row.ourairports_id),
  a.icao_code = row.icao_code,
  a.iata_code = row.iata_code,
  a.gps_code = row.gps_code,
  a.name = row.name,
  a.airport_type = row.airport_type,
  a.country_code = row.country_code,
  a.region_code = row.region_code,
  a.municipality = row.municipality,
  a.lat = toFloat(row.lat),
  a.lon = toFloat(row.lon),
  a.elevation_ft = toFloat(row.elevation_ft),
  a.scheduled_service = toBoolean(row.scheduled_service),
  a.longest_paved_runway_ft = toInteger(row.longest_paved_runway_ft),
  a.longest_paved_runway_width_ft = toFloat(row.longest_paved_runway_width_ft),
  a.longest_paved_runway_surface = row.longest_paved_runway_surface,
  a.open_paved_runway_count = toInteger(row.open_paved_runway_count),
  a.location = point({longitude: toFloat(row.lon), latitude: toFloat(row.lat)});

LOAD CSV WITH HEADERS FROM 'file:///nodes/runways.csv' AS row
MATCH (a:Airfield {airfield_id: row.airfield_id})
CREATE (a)-[:HAS_RUNWAY]->(r:Runway {runway_id: row.runway_id})
SET
  r.designation = row.designation,
  r.length_ft = toFloat(row.length_ft),
  r.width_ft = toFloat(row.width_ft),
  r.surface = row.surface,
  r.paved = toBoolean(row.paved),
  r.lighted = toBoolean(row.lighted),
  r.closed = toBoolean(row.closed);

LOAD CSV WITH HEADERS FROM 'file:///nodes/sea_nodes.csv' AS row
CREATE (:SeaNode {sea_node_id: row.sea_node_id, lon: toFloat(row.lon), lat: toFloat(row.lat),
  location: point({longitude: toFloat(row.lon), latitude: toFloat(row.lat)})});

LOAD CSV WITH HEADERS FROM 'file:///nodes/passages.csv' AS row
CREATE (:Passage {passage_id: row.passage_id, name: row.name, kind: row.kind,
  tag_method: row.tag_method, max_draft_m: toFloat(row.max_draft_m), bbox: row.bbox,
  segment_count: toInteger(row.segment_count)});

// ---- sea network: stored one way, traversed both ways
LOAD CSV WITH HEADERS FROM 'file:///relationships/sea_segments.csv' AS row
MATCH (a:SeaNode {sea_node_id: row.from_sea_node_id}), (b:SeaNode {sea_node_id: row.to_sea_node_id})
CREATE (a)-[:SEA_SEGMENT {length_nm: toFloat(row.length_nm), segment_id: row.segment_id, passage: row.passage,
  tag_method: row.tag_method, geometry_wkt: row.geometry_wkt}]->(b);

LOAD CSV WITH HEADERS FROM 'file:///relationships/port_to_sea_node.csv' AS row
MATCH (p:Port {port_id: row.port_id}), (s:SeaNode {sea_node_id: row.sea_node_id})
CREATE (p)-[:SEA_ACCESS {length_nm: toFloat(row.length_nm), segment_id: row.segment_id, passage: row.passage,
  tag_method: row.tag_method, geometry_wkt: row.geometry_wkt}]->(s);

LOAD CSV WITH HEADERS FROM 'file:///relationships/port_to_port.csv' AS row
MATCH (a:Port {port_id: row.from_port_id}), (b:Port {port_id: row.to_port_id})
CREATE (a)-[:SEA_ACCESS {length_nm: toFloat(row.length_nm), segment_id: row.segment_id, passage: row.passage,
  tag_method: row.tag_method, geometry_wkt: row.geometry_wkt}]->(b);

// ---- check: compare with build-report.json
MATCH (n) RETURN labels(n)[0] AS label, count(*) AS nodes ORDER BY label;
MATCH ()-[r]->() RETURN type(r) AS type, count(*) AS relationships ORDER BY type;
